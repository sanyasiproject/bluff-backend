# Port is set automatically on Render; 3001 locally
PORT=3001
# Your Vercel URL(s), comma-separated. Leave empty locally (allows localhost + home Wi-Fi only)
CLIENT_ORIGIN=https://your-bluff-app.vercel.app
# MongoDB connection string for accounts; leave empty for guest-only. Keep it secret.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=bluff
